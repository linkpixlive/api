generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  streamer
}

enum DonationStatus {
  pending
  paid
  displayed
  failed
  expired
}

enum PaymentMethod {
  pix
}

enum WithdrawalStatus {
  pending
  processing
  success
  failed
}

enum TransactionType {
  donation
  withdrawal
  withdraw_reserve
  withdraw_confirm
  refund
}

enum PixKeyType {
  cpf
  cnpj
  email
  phone
  random
}

enum MessageType {
  audio
  text
}

enum GatewayProvider {
  efi
}

enum InteractionType {
  GENERATE_DONATION_QRCODE
  RESPONSE_WEBHOOK_PIX
  REQUEST_WITHDRAWAL
  RESPONSE_WEBHOOK_WITHDRAWAL
}

enum WidgetType {
  overlay
  qrcode
}

model User {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @db.VarChar(100)
  email            String   @unique @db.VarChar(255)
  username         String   @unique @db.VarChar(50)
  password         String   @db.VarChar(255)
  
  profileImageUrl  String?  @map("profile_image_url") @db.VarChar(500)
  cpf              String?  @unique @db.VarChar(255)
  cpfHash          String?  @unique @map("cpf_hash") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")
  
  active           Boolean  @default(true)
  verifiedEmail    Boolean  @default(false) @map("verified_email")
  roles            UserRole[] @default([streamer])
  overlayKey       String   @unique @default(uuid()) @map("overlay_key") @db.VarChar(36)

  wallet           Wallet?
  pixKeys          PixKey[]           
  donationsReceived Donation[]        @relation("ReceivedDonations")
  withdrawals      Withdrawal[]
  transactions     Transaction[]
  changePassword   ChangePassword[]   
  donationSettings DonationSettings?  
  widgets          Widget[]

  @@index([email])
  @@index([username])
  @@index([cpfHash])
  @@map("users")
}

model Wallet {
  id               String   @id @default(uuid()) @db.VarChar(36)
  user_id          String   @unique @db.VarChar(36)
  current_balance  Decimal  @default(0) @db.Decimal(12, 2)
  pending_balance  Decimal  @default(0) @db.Decimal(12, 2)
  blocked_balance  Decimal  @default(0) @db.Decimal(12, 2)
  last_transaction_id String? @db.VarChar(36)
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("wallets")
}

model PixKey {
  id         String   @id @default(uuid()) @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  key        String   @db.Text
  key_hashed String   @db.VarChar(255)
  key_masked String   @db.VarChar(255)
  key_type   PixKeyType
  created_at DateTime @default(now())
  alias      String?  @db.VarChar(100)
  default    Boolean  @default(false)

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@unique([user_id, key_hashed])
  @@index([user_id])
  @@map("pix_keys")
}

model Donation {
  id              String         @id @default(uuid()) @db.VarChar(36)
  user_id         String         @db.VarChar(36)
  name            String         @db.VarChar(100)
  message_raw     String?        @db.VarChar(500)
  message         String?        @db.VarChar(500)
  message_type    MessageType?
  voice_id        String?        @db.VarChar(50)
  voice_url       String?        @db.VarChar(500)
  amount          Decimal        @db.Decimal(12, 2)
  status          DonationStatus @default(pending)
  payment_method  PaymentMethod  @default(pix)
  pix             String?        @db.Text
  created_at      DateTime       @default(now())
  expired_at      DateTime?
  approved_at     DateTime?
  transaction_id  String         @unique @db.VarChar(100)
  ip              String?        @db.VarChar(255)

  user            User           @relation("ReceivedDonations", fields: [user_id], references: [id], onDelete: Cascade)
  transaction     Transaction?

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([transaction_id])
  @@map("donations")
}

model Withdrawal {
  id              String           @id @default(uuid()) @db.VarChar(36)
  user_id         String           @db.VarChar(36)
  pix_id          String?           @db.VarChar(36)
  pix_value       String           @db.VarChar(255)
  status          WithdrawalStatus @default(pending)
  gross_amount    Decimal          @db.Decimal(12, 2)
  net_amount      Decimal          @db.Decimal(12, 2)
  fee_amount      Decimal          @default(0) @db.Decimal(12, 2)
  transaction_id  String?          @db.VarChar(100)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pix_key                PixKey?                @relation(fields: [pix_id], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("withdrawals")
}

model Transaction {
  id              String                   @id @default(uuid()) @db.VarChar(36)
  user_id         String                   @db.VarChar(36)
  transaction_id  String                   @db.VarChar(100)
  type            TransactionType
  amount          Decimal                  @db.Decimal(12, 2)
  balance_after   Decimal                  @db.Decimal(12, 2)
  created_at      DateTime                 @default(now())
  ip              String?                  @db.VarChar(255)

  donation_id    String?   @unique @db.VarChar(36)
  withdrawal_id  String?   @unique @db.VarChar(36)

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  donation   Donation?   @relation(fields: [donation_id], references: [id], onDelete: SetNull)
  withdrawal Withdrawal? @relation(fields: [withdrawal_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([type])
  @@index([created_at])
  @@index([donation_id])
  @@index([withdrawal_id])
  @@map("transactions")
}

model ChangePassword {
  id                  String                  @id @default(uuid()) @db.VarChar(36)
  user_id             String                  @db.VarChar(36)
  token               String                  @unique @db.VarChar(255)
  created_at          DateTime                @default(now())
  expires_at          DateTime

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@map("change_password")
}

model GatewayResponse {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  external_id         String?  @map("external_id") @db.VarChar(100)
  interaction_type    InteractionType
  status_code         Int?
  payload             Json
  provider            GatewayProvider
  created_at          DateTime @default(now())

  @@index([external_id])
  @@map("gateway_responses")
}

model DonationSettings {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @unique @map("user_id") @db.VarChar(36)
  maxLength      Int      @default(250) @map("max_length")
  minAudioAmount Decimal  @default(1.00) @map("min_audio_amount") @db.Decimal(12, 2)
  minTextAmount  Decimal  @default(1.00) @map("min_text_amount") @db.Decimal(12, 2)
  filterProfanity Boolean  @default(false) @map("filter_profanity")
  filterSpam      Boolean  @default(false) @map("filter_spam")
  blockedWords    String[] @default([]) @map("blocked_words")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("donation_settings")
}

model Widget {
  id        String     @id @default(uuid()) @db.VarChar(36)
  userId    String     @map("user_id") @db.VarChar(36)
  type      WidgetType
  settings  Json       @default("{}")
  active    Boolean    @default(true)
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("widgets")
}