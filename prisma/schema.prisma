generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  streamer
}

enum DonationStatus {
  pending
  paid
  displayed
  failed
  expired
}

enum PaymentMethod {
  pix
}

enum WithdrawalStatus {
  pending
  processing
  success
  failed
}

enum TransactionType {
  donation
  withdrawal
  withdraw_reserve
  withdraw_confirm
  refund
}

enum PixKeyType {
  cpf
  cnpj
  email
  phone
  random
}

enum MessageType {
  audio
  text
}

enum GatewayProvider {
  efi
}

enum InteractionType {
  GENERATE_DONATION_QRCODE
  RESPONSE_WEBHOOK_PIX
  REQUEST_WITHDRAWAL
  RESPONSE_WEBHOOK_WITHDRAWAL
}

enum WidgetType {
  overlay
  qrcode
}

model User {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @db.VarChar(100)
  email            String   @unique @db.VarChar(255)
  username         String   @unique @db.VarChar(50)
  password         String   @db.VarChar(255)
  
  profileImageUrl  String?  @map("profile_image_url") @db.VarChar(500)
  cpf              String?  @unique @db.VarChar(255)
  cpfHash          String?  @unique @map("cpf_hash") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")
  
  active           Boolean  @default(true)
  verifiedEmail    Boolean  @default(false) @map("verified_email")
  verified         Boolean  @default(false)
  usernameChangedAt DateTime? @map("username_changed_at")
  roles            UserRole[] @default([streamer])
  totpSecret       String?  @map("totp_secret") @db.VarChar(500)
  totpEnabled      Boolean  @default(false) @map("totp_enabled")

  wallet           Wallet?
  pixKeys          PixKey[]           
  donationsReceived Donation[]        @relation("ReceivedDonations")
  withdrawals      Withdrawal[]
  transactions     Transaction[]
  changePassword   ChangePassword[]   
  donationSettings DonationSettings?  
  widgets          Widget[]
  usernameBlacklists UsernameBlacklist[] @relation("OriginalOwner")

  @@index([email])
  @@index([username])
  @@index([cpfHash])
  @@map("users")
}

model UsernameBlacklist {
  id              String    @id @default(uuid()) @db.VarChar(36)
  username        String    @unique @db.VarChar(50)
  originalOwnerId String    @map("original_owner_id") @db.VarChar(36)
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  originalOwner User @relation("OriginalOwner", fields: [originalOwnerId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([expiresAt])
  @@map("username_blacklist")
}

model Wallet {
  id                String   @id @default(uuid()) @db.VarChar(36)
  userId            String   @unique @map("user_id") @db.VarChar(36)
  currentBalance    Decimal  @default(0) @map("current_balance") @db.Decimal(12, 2)
  pendingBalance    Decimal  @default(0) @map("pending_balance") @db.Decimal(12, 2)
  blockedBalance    Decimal  @default(0) @map("blocked_balance") @db.Decimal(12, 2)
  lastTransactionId String?  @map("last_transaction_id") @db.VarChar(36)
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

model PixKey {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  key       String   @db.Text
  keyHashed String   @map("key_hashed") @db.VarChar(255)
  keyMasked String   @map("key_masked") @db.VarChar(255)
  keyType   PixKeyType @map("key_type")
  createdAt DateTime @default(now()) @map("created_at")
  alias     String?  @db.VarChar(100)
  default   Boolean  @default(false)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@unique([userId, keyHashed])
  @@index([userId])
  @@map("pix_keys")
}

model Voice {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(100)
  provider  String   @db.VarChar(50)
  voiceId   String   @map("voice_id") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  photoUri  String?  @map("photo_uri") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  donationSettings DonationSettings[]
  donations        Donation[]

  @@map("voices")
}

model Donation {
  id            String         @id @default(uuid()) @db.VarChar(36)
  userId        String         @map("user_id") @db.VarChar(36)
  name          String         @db.VarChar(100)
  messageRaw    String?        @map("message_raw") @db.VarChar(500)
  message       String?        @db.VarChar(500)
  messageType   MessageType?   @map("message_type")
  voiceId       String?        @map("voice_id") @db.VarChar(36)
  voiceUrl      String?        @map("voice_url") @db.VarChar(500)
  amount        Decimal        @db.Decimal(12, 2)
  status        DonationStatus @default(pending)
  paymentMethod PaymentMethod  @default(pix) @map("payment_method")
  pix           String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  expiredAt     DateTime?      @map("expired_at")
  approvedAt    DateTime?      @map("approved_at")
  transactionId String         @unique @map("transaction_id") @db.VarChar(100)
  ip            String?        @db.VarChar(255)

  user        User         @relation("ReceivedDonations", fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?
  voice       Voice?       @relation(fields: [voiceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([transactionId])
  @@map("donations")
}

model Withdrawal {
  id            String           @id @default(uuid()) @db.VarChar(36)
  userId        String           @map("user_id") @db.VarChar(36)
  pixId         String?          @map("pix_id") @db.VarChar(36)
  pixValue      String           @map("pix_value") @db.VarChar(255)
  keyMasked     String           @map("key_masked") @db.VarChar(255)
  clientKey     String?          @map("client_key") @db.VarChar(128)
  status        WithdrawalStatus @default(pending)
  grossAmount   Decimal          @map("gross_amount") @db.Decimal(12, 2)
  netAmount     Decimal          @map("net_amount") @db.Decimal(12, 2)
  feeAmount     Decimal          @default(0) @map("fee_amount") @db.Decimal(12, 2)
  transactionId String?          @map("transaction_id") @db.VarChar(100)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixKey      PixKey?      @relation(fields: [pixId], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@unique([userId, clientKey], name: "withdrawals_user_client_key")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

model Transaction {
  id            String          @id @default(uuid()) @db.VarChar(36)
  userId        String          @map("user_id") @db.VarChar(36)
  transactionId String          @map("transaction_id") @db.VarChar(100)
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(12, 2)
  createdAt     DateTime        @default(now()) @map("created_at")
  ip            String?         @db.VarChar(255)

  donationId    String? @unique @map("donation_id") @db.VarChar(36)
  withdrawalId  String? @unique @map("withdrawal_id") @db.VarChar(36)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  donation   Donation?   @relation(fields: [donationId], references: [id], onDelete: SetNull)
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([donationId])
  @@index([withdrawalId])
  @@map("transactions")
}

model ChangePassword {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("change_password")
}

model GatewayResponse {
  id              String          @id @default(uuid()) @db.VarChar(36)
  externalId      String?         @map("external_id") @db.VarChar(100)
  interactionType InteractionType @map("interaction_type")
  statusCode      Int?            @map("status_code")
  payload         Json
  provider        GatewayProvider
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([externalId])
  @@map("gateway_responses")
}

model DonationSettings {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @unique @map("user_id") @db.VarChar(36)
  maxLength      Int      @default(250) @map("max_length")
  minAudioAmount Decimal  @default(1.00) @map("min_audio_amount") @db.Decimal(12, 2)
  minTextAmount  Decimal  @default(1.00) @map("min_text_amount") @db.Decimal(12, 2)
  filterProfanity Boolean  @default(false) @map("filter_profanity")
  filterSpam      Boolean  @default(false) @map("filter_spam")
  blockedWords    String[] @default([]) @map("blocked_words")
  defaultVoiceId  String?  @map("default_voice_id") @db.VarChar(36)
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultVoice    Voice?   @relation(fields: [defaultVoiceId], references: [id], onDelete: SetNull)

  @@map("donation_settings")
}

model Widget {
  id        String     @id @default(uuid()) @db.VarChar(36)
  userId    String     @map("user_id") @db.VarChar(36)
  type      WidgetType
  settings  Json       @default("{}")
  active    Boolean    @default(true)
  token     String     @unique @default(uuid()) @db.VarChar(36)
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("widgets")
}