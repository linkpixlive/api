{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": ["ts-jest", { "tsconfig": { "allowJs": true, "module": "commonjs" } }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!.*@(?:scure|noble)/)"
  ]
}
